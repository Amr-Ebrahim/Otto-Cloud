# Copy this file to .env and fill in your keys. Never upload .env anywhere.

# Groq - speech-to-text + brain (free): https://console.groq.com/keys
GROQ_API_KEY=

# Google AI Studio - Bodi's voice (free): https://aistudio.google.com/apikey
# Leave empty to use only the backup voice.
GEMINI_API_KEY=
GEMINI_VOICE=Bodi

# Microphone number - find yours with: python tools\find_mic.py
# Leave empty to use the Windows default microphone.
INPUT_DEVICE=

# Bodi's limits. Free plan = 10 a day, 3 a minute. Raise them if you enable billing.
GEMINI_TTS_RPD=10
GEMINI_TTS_RPM=3

# Backup voice (Microsoft Edge, free)
EDGE_VOICE=ar-EG-ShakirNeural

# Wake word sensitivity: lower = wakes more easily. Tune with: python tools\test_wake.py
WAKE_THRESHOLD=0.04
